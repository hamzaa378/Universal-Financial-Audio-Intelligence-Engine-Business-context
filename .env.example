FINAI_WHISPER_MODEL=small
FINAI_DEVICE=auto
FINAI_COMPUTE_TYPE=auto
FINAI_BEAM_SIZE=5
FINAI_BEST_OF=5
FINAI_SEMANTIC_AI=0
FINAI_PRIVACY_PROFILE=balanced
# Optional: force a FastEmbed model supported by your installed version.
# FINAI_SEMANTIC_MODEL=
FINAI_DIARIZATION=0
# HF_TOKEN=hf_...
FINAI_ZERO_SHOT=0

# v4.12: targeted second decode for unresolved follow-up or explicitly owned sensitive fields.
FINAI_PRIVACY_REDECODE=1
FINAI_PRIVACY_REDECODE_MAX_WINDOWS=4
# If the alternate decode also fails, protect a short response audio window.
FINAI_PRIVACY_CONSERVATIVE_AUDIO_GUARD=1

# v4.12 opt-in diagnostics. WARNING: raw transcript debug files contain PII.
FINAI_PRIVACY_DEBUG_ARTIFACTS=0
FINAI_PRIVACY_DEBUG_DIR=privacy_debug
